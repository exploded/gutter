{{/*
Shared brand pieces for the card and logo pages: the @font-face block, the
palette, and the horizontal lockup (mark left; "Up The Spout" in Lilita One
over tracked "GUTTER CLEANING" in Figtree ExtraBold at 30% of its size).

The lockup is sized in em, so set font-size on .lockup to scale the whole
thing: 1em is the cap-to-baseline reference size of "Up The Spout".
*/}}

{{define "fonts-css"}}
@font-face{font-family:"UTS Display";src:url("{{.Fonts.Display}}") format("truetype");font-weight:400;font-style:normal}
@font-face{font-family:"UTS Sans";src:url("{{.Fonts.Sans400}}") format("truetype");font-weight:400;font-style:normal}
@font-face{font-family:"UTS Sans";src:url("{{.Fonts.Sans500}}") format("truetype");font-weight:500;font-style:normal}
@font-face{font-family:"UTS Sans";src:url("{{.Fonts.Sans800}}") format("truetype");font-weight:800;font-style:normal}
:root{
  --ink:#12284A; --ink-dark:#0B1A33; --tangerine:#FF7A21; --tangerine-text:#B34700;
  --sky:#4DB0FF; --sky-text:#1561C0; --sun:#FFD449; --cream:#FFF7EA; --white:#FFFFFF;
}
{{end}}

{{define "lockup-css"}}
.lockup{display:inline-flex;align-items:center;gap:.34em;line-height:1;white-space:nowrap}
.lockup .mark{flex:none;width:1.5em;height:1.5em}
.lockup .mark svg{display:block;width:100%;height:100%;overflow:visible}
.lockup .words{display:flex;flex-direction:column;align-items:flex-start}
/* text-box trims each line to cap height and baseline, so the gaps below are
   true optical gaps and the block centres on the mark without fudge factors. */
.lockup .w{font-family:"UTS Display",sans-serif;font-weight:400;font-size:1em;letter-spacing:.01em;
  font-kerning:normal;text-box:trim-both cap alphabetic}
.lockup .g{font-family:"UTS Sans",sans-serif;font-weight:800;font-size:.30em;letter-spacing:.24em;
  margin-right:-.24em;margin-top:.83em;text-box:trim-both cap alphabetic}
/* On a navy field the badge would vanish into the background, so it is
   redrawn a shade darker with a hairline cream edge (see card.tmpl for why). */
.lockup.on-ink .mark rect{fill:var(--ink-dark);stroke:rgba(255,247,234,.55);stroke-width:.9}
.lockup.on-ink .mark path[stroke="#12284A"]{stroke:var(--ink-dark)}
{{end}}

{{define "lockup"}}<div class="lockup {{.LockupClass}}"><div class="mark">{{.Mark}}</div><div class="words"><span class="w">Up The Spout</span><span class="g">GUTTER CLEANING</span></div></div>{{end}}
