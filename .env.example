# ── Warrandyte Gutters — environment ──────────────────────────────────────────
# Copy to .env (git-ignored) and fill in. Every var is optional: the default
# noted in the comment is used when the line is missing or empty. The app loads
# .env from APP_DIR at startup; real environment variables take precedence.
# Note: comments must be on their own line (no trailing "# …" after a value).
# Prices are not configured here — they live in cmd/server/pricing.go.

# ── Server ───────────────────────────────────────────────────────────────────
# Listen port. Default: 8080
PORT=8080
# Directory holding .env and app.db. Default: .
APP_DIR=.
# Any non-empty value = production (BASE_URL default becomes https://warrandytegutters.com.au)
PROD=
# Canonical origin for OAuth redirects and email links; other hosts 301 here.
# Default: https://warrandytegutters.com.au if PROD, else http://localhost:PORT
BASE_URL=

# Background scheduler (day-before customer reminder, 1-hour admin heads-up,
# 07:30 morning digest, 02:00 DB backup). Runs automatically when PROD is set;
# set to 1 to run it locally, or 0 to disable it in production.
SCHEDULER=

# ── Site contact ─────────────────────────────────────────────────────────────
# Display phone. Default: empty (hides all phone UI)
PHONE=
# Contact email shown on the site. Also the SES sender ("Warrandyte Gutters <…>",
# must be a verified SES identity) and where booking notifications go.
# Default: vin@warrandytegutters.com.au
CONTACT_EMAIL=
# First name used in "I'm Vin" copy and email sign-offs. Default: Vin
OWNER_NAME=

# Seniors Card discount, % off the total (0 hides it site-wide). Default: 0
SENIORS_DISCOUNT_PCT=0

# ── Invoices ─────────────────────────────────────────────────────────────────
# ABN printed on invoices and the footer. Default: empty (hidden)
ABN=
# Bank transfer details printed on invoices/emails. BSB empty = bank block hidden
# (customers then see only the Zeller payment link / pay-on-the-day).
BANK_ACCOUNT_NAME=
BANK_BSB=
BANK_ACCOUNT_NO=

# ── Admin (Google sign-in) ───────────────────────────────────────────────────
# Comma-separated Google accounts allowed into /admin. The first is the primary
# admin, whose account Google Calendar sync connects to. Default: james67@gmail.com
ADMIN_EMAIL=james67@gmail.com
# Google OAuth client. Empty = sign-in disabled, /admin unreachable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Booking form ─────────────────────────────────────────────────────────────
# Mappify address autocomplete (mappify.io). The form requires an address picked
# from the suggestions, so without a key nobody can submit a booking.
MAPPIFY_API_KEY=

# ── Google tag (Analytics + Ads) ─────────────────────────────────────────────
# Nothing loads until an ID is set, and only when PROD is set.
GA4_ID=
GOOGLE_ADS_ID=
# Conversion labels from the conversion actions created in Google Ads.
GOOGLE_ADS_BOOKING_LABEL=
GOOGLE_ADS_CALL_LABEL=
# Comma-separated profile URLs (Google Business Profile, Facebook) for JSON-LD sameAs.
SAME_AS=

# ── Google reviews ───────────────────────────────────────────────────────────
# Google Business Profile review link. In the Business Profile, choose
# "Ask for reviews" and copy the share link (https://g.page/r/…/review).
# Empty = /review, the QR card and the receipt-email review ask are all hidden.
REVIEW_URL=

# ── SEO ──────────────────────────────────────────────────────────────────────
# IndexNow key (bing.com/indexnow); served at /{key}.txt. Empty = route disabled.
INDEXNOW_KEY=

# ── Email (Amazon SES) ───────────────────────────────────────────────────────
# scripts/ses-setup.sh creates the IAM user and prints these. Empty = email
# disabled (sends are logged instead — fine for local dev).
# Default region: ap-southeast-2
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database backups (Amazon S3) ─────────────────────────────────────────────
# scripts/s3-backup-setup.sh creates the bucket + put-only IAM user and prints
# these. Empty = no backups (the scheduler job is skipped). Uses AWS_REGION.
BACKUP_S3_BUCKET=warrandyte-gutters-backups
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
